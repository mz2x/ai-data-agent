# Copy to .env for local `npm start` runs (gitignored, never commit).
# In a container, pass these via `docker run -e` / an --env-file / compose
# instead of baking a .env into the image.

ANTHROPIC_API_KEY=
METABASE_API_KEY=
METABASE_URL=https://metabase.example.com

MODEL=claude-sonnet-5
PORT=8787

# Optional — Slack bot (Socket Mode, no public URL needed). Leave unset to
# run the chat page only.
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...
# Access control: whoever is a member of this private channel can use the
# bot (there or by DM). Manage access by inviting/removing people from the
# channel in Slack — nothing to redeploy per person.
SLACK_TEAM_CHANNEL_ID=
