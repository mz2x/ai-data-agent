# Copy to .env in this same folder (gitignored, never commit).
METABASE_URL=https://metabase.example.com
METABASE_API_KEY=

# Optional: only needed if the Metabase instance has more than one database
# connected and auto-detection picks the wrong one. Run `node query.js` with
# no arguments to print the detected databases and their ids.
METABASE_DATABASE_ID=
